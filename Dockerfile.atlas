FROM golang:1.24-alpine AS builder

# Install Atlas CLI
RUN apk add --no-cache curl
RUN curl -sSf https://atlasgo.sh | sh

FROM alpine:latest

# Install PostgreSQL client for connectivity
RUN apk add --no-cache postgresql-client

# Copy Atlas binary from builder
COPY --from=builder /usr/local/bin/atlas /usr/local/bin/atlas

# Set working directory
WORKDIR /app

# Copy configuration and schema files
COPY atlas.hcl .
COPY schema.sql .
COPY atlas-migrations/ ./atlas-migrations/

# Default command to run migrations
CMD ["atlas", "migrate", "apply", "--env", "dev"]
